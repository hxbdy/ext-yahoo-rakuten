{
  "manifest_version": 3,
  "name": "楽天・Yahoo!ショッピング 価格比較",
  "version": "1.0.0",
  "description": "We display the prices from the other sites on product pages on Rakuten Ichiba and Yahoo! Shopping.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://search.rakuten.co.jp/*",
    "https://shopping.yahoo.co.jp/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://item.rakuten.co.jp/*", "https://store.shopping.yahoo.co.jp/*"],
      "js": ["jan.js", "sites.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
